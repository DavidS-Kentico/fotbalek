<div class="card h-full @(Highlight ? "border-brand" : "")">
    <div class="card-body text-center">
        <Avatar AvatarId="@Player.AvatarId" Size="lg" />
        <h6 class="card-title mt-2 mb-1">@Player.Name</h6>
        <p class="text-ink-muted text-small mb-0">ELO: @Player.Elo</p>
        @if (!Player.IsActive)
        {
            <span class="badge bg-neutral">Inactive</span>
        }
    </div>
    @if (ShowActions)
    {
        <div class="card-footer bg-transparent border-t-0">
            <div class="flex gap-2 justify-center">
                <a href="@($"/team/{TeamCode}/players/{Player.Id}")" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-eye"></i>
                </a>
                @if (OnEdit.HasDelegate)
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => OnEdit.InvokeAsync(Player)">
                        <i class="bi bi-pencil"></i>
                    </button>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public PlayerDto Player { get; set; } = null!;
    [Parameter] public string? TeamCode { get; set; }
    [Parameter] public bool ShowActions { get; set; } = true;
    [Parameter] public bool Highlight { get; set; }
    [Parameter] public EventCallback<PlayerDto> OnEdit { get; set; }
}
