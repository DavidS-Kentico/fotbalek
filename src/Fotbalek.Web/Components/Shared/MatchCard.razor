@* One match, as a row: team A · score · team B, with a meta strip underneath
   carrying the time, the margin/season chips and the caller's per-row Actions.

   The anatomy is `.match-card__*` in Styles/components/match.css. Two things worth
   knowing before editing the markup:
     * the ELO chip belongs to a *side*, not to the score — that is what lets the
       centre stay two numbers and a colon at any width;
     * a left accent stripe (green/red) marks how the match went for the signed-in
       player, matching the .stat-card / .award-tile accent idiom. It only appears
       when that player was on the pitch.

   Compact (dashboard, player detail) is the same anatomy a size down with the
   meta strip dropped — not a second layout. *@

@{
    var team1Players = Match.MatchPlayers.Where(mp => mp.TeamNumber == 1).OrderBy(mp => mp.Position).ToList();
    var team2Players = Match.MatchPlayers.Where(mp => mp.TeamNumber == 2).OrderBy(mp => mp.Position).ToList();
    var team1Won = Match.Team1Score > Match.Team2Score;
    var meInTeam1 = MyPlayerId.HasValue && team1Players.Any(mp => mp.PlayerId == MyPlayerId);
    var meInTeam2 = MyPlayerId.HasValue && team2Players.Any(mp => mp.PlayerId == MyPlayerId);
    var meWon = (team1Won && meInTeam1) || (!team1Won && meInTeam2);
    var meLost = (meInTeam1 || meInTeam2) && !meWon;
    var resultClass = meWon ? "match-card--won" : meLost ? "match-card--lost" : "";

    // Both teammates always receive the same ELO change (zero-sum), so show one chip per team.
    // The chip shows the match's own ladder: seasonal ELO change for seasonal matches,
    // all-time change for off-season ones (contextual display rule).
    var isSeasonal = Match.SeasonId != null;
    var team1Change = isSeasonal
        ? team1Players.FirstOrDefault()?.SeasonEloChange ?? 0
        : team1Players.FirstOrDefault()?.EloChange ?? 0;
    var team2Change = isSeasonal
        ? team2Players.FirstOrDefault()?.SeasonEloChange ?? 0
        : team2Players.FirstOrDefault()?.EloChange ?? 0;

    var margin = Math.Abs(Match.Team1Score - Match.Team2Score);
    string? marginLabel = null;
    string? marginCss = null;
    string? marginIcon = null;
    if (margin >= 8) { marginLabel = "Blowout"; marginCss = "match-card__chip--hot"; marginIcon = "bi-fire"; }
    else if (margin == 1) { marginLabel = "Nail-biter"; marginCss = "match-card__chip--close"; marginIcon = "bi-lightning-charge"; }

    string DeltaClass(int delta) => delta > 0 ? "match-card__delta--up"
        : delta < 0 ? "match-card__delta--down"
        : "";
    string DeltaText(int delta) => (delta > 0 ? "+" : "") + delta.ToString();
}

<article class="match-card @resultClass @(Compact ? "match-card--compact" : "") @Class">
    <div class="match-card__row">
        <div class="match-card__side match-card__side--a @(team1Won ? "is-winner" : "")">
            <div class="match-card__players">
                @foreach (var mp in team1Players)
                {
                    <a href="/team/@TeamCode/players/@mp.PlayerId"
                       class="match-card__player @(mp.PlayerId == MyPlayerId ? "is-me" : "")">
                        <Avatar AvatarId="@mp.PlayerAvatarId" Size="sm" />
                        <span class="match-card__name">@mp.PlayerName</span>
                    </a>
                }
            </div>
            <span class="match-card__tail">
                @if (team1Won)
                {
                    <i class="bi bi-trophy-fill match-card__trophy" title="Team 1 won"></i>
                }
                <span class="match-card__delta @DeltaClass(team1Change)" title="Team 1 ELO change">@DeltaText(team1Change)</span>
            </span>
        </div>

        <a href="/team/@TeamCode/matches/@Match.Id" class="match-card__score" aria-label="Match detail">
            <span class="match-card__goals @(team1Won ? "is-winner" : "")">@Match.Team1Score</span>
            <span class="match-card__colon">:</span>
            <span class="match-card__goals @(!team1Won ? "is-winner" : "")">@Match.Team2Score</span>
        </a>

        <div class="match-card__side match-card__side--b @(!team1Won ? "is-winner" : "")">
            <span class="match-card__tail">
                <span class="match-card__delta @DeltaClass(team2Change)" title="Team 2 ELO change">@DeltaText(team2Change)</span>
                @if (!team1Won)
                {
                    <i class="bi bi-trophy-fill match-card__trophy" title="Team 2 won"></i>
                }
            </span>
            <div class="match-card__players">
                @foreach (var mp in team2Players)
                {
                    <a href="/team/@TeamCode/players/@mp.PlayerId"
                       class="match-card__player @(mp.PlayerId == MyPlayerId ? "is-me" : "")">
                        <Avatar AvatarId="@mp.PlayerAvatarId" Size="sm" />
                        <span class="match-card__name">@mp.PlayerName</span>
                    </a>
                }
            </div>
        </div>
    </div>

    @* The strip carries the row's chrome. Compact feeds drop it, unless the caller
       still needs somewhere to hang its Actions. *@
    @if (!Compact || Actions != null)
    {
        <div class="match-card__meta">
            @if (!Compact)
            {
                @if (DateLabel != null)
                {
                    <span class="match-card__time" title="@DateTitle">
                        <i class="bi bi-clock"></i>@DateLabel
                    </span>
                }
                else
                {
                    <span class="match-card__time">
                        <i class="bi bi-calendar3"></i>
                        <span class="match-date" data-utc="@Match.PlayedAt.ToString("o")">@Match.PlayedAt.ToString("g")</span>
                    </span>
                }
                @if (marginLabel != null)
                {
                    <span class="match-card__chip @marginCss" title="@($"Score margin: {margin}")">
                        <i class="bi @marginIcon"></i>@marginLabel
                    </span>
                }
                @if (ShowSeasonChip)
                {
                    @if (SeasonName != null)
                    {
                        <span class="match-card__chip match-card__chip--season" title="Seasonal match">
                            <i class="bi bi-award"></i>@SeasonName
                        </span>
                    }
                    else
                    {
                        <span class="match-card__chip" title="Not part of any season">off-season</span>
                    }
                }
            }
            @if (Actions != null)
            {
                <div class="match-card__actions">@Actions</div>
            }
        </div>
    }
</article>

@code {
    [Parameter, EditorRequired] public MatchDto Match { get; set; } = null!;
    [Parameter] public string? TeamCode { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>
    /// Extra classes for the card's root — in practice the outer margin. The card owns no
    /// spacing of its own: how far apart two cards sit is the containing feed's decision,
    /// and baking a margin in here meant every denser list had to override it with
    /// <c>!important</c> (utilities outrank the components layer).
    /// </summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Show the season / off-season chip (pages enable this once the team has seasons).</summary>
    [Parameter] public bool ShowSeasonChip { get; set; }
    /// <summary>Season name for the chip; null renders a muted "off-season" chip.</summary>
    [Parameter] public string? SeasonName { get; set; }

    /// <summary>
    /// Pre-formatted date/time shown on the meta line (non-compact only). When set, it is rendered
    /// as-is with a clock icon — callers pass a timezone-local label (e.g. "18:30") so no client-side
    /// JS date swap is needed. When null, falls back to the JS-localized <c>.match-date</c> span.
    /// </summary>
    [Parameter] public string? DateLabel { get; set; }

    /// <summary>Full local date/time for the <see cref="DateLabel"/> tooltip.</summary>
    [Parameter] public string? DateTitle { get; set; }

    [CascadingParameter(Name = "MyPlayerId")] public int? MyPlayerId { get; set; }
}
