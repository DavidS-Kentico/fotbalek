@{
    var team1Players = Match.MatchPlayers.Where(mp => mp.TeamNumber == 1).ToList();
    var team2Players = Match.MatchPlayers.Where(mp => mp.TeamNumber == 2).ToList();
    var team1Won = Match.Team1Score > Match.Team2Score;
    var meInTeam1 = MyPlayerId.HasValue && team1Players.Any(mp => mp.PlayerId == MyPlayerId);
    var meInTeam2 = MyPlayerId.HasValue && team2Players.Any(mp => mp.PlayerId == MyPlayerId);
    var meWon = (team1Won && meInTeam1) || (!team1Won && meInTeam2);
    var meLost = (meInTeam1 || meInTeam2) && !meWon;

    // Both teammates always receive the same ELO change (zero-sum), so show one chip per team.
    // The chip shows the match's own ladder: seasonal ELO change for seasonal matches,
    // all-time change for off-season ones (contextual display rule).
    var isSeasonal = Match.SeasonId != null;
    var team1Change = isSeasonal
        ? team1Players.FirstOrDefault()?.SeasonEloChange ?? 0
        : team1Players.FirstOrDefault()?.EloChange ?? 0;
    var team2Change = isSeasonal
        ? team2Players.FirstOrDefault()?.SeasonEloChange ?? 0
        : team2Players.FirstOrDefault()?.EloChange ?? 0;

    var margin = Math.Abs(Match.Team1Score - Match.Team2Score);
    string? marginLabel = null;
    string? marginCss = null;
    string? marginIcon = null;
    if (margin >= 8) { marginLabel = "Blowout"; marginCss = "bg-warning-subtle text-warning-subtle-ink"; marginIcon = "bi-fire"; }
    else if (margin == 1) { marginLabel = "Nail-biter"; marginCss = "bg-info-subtle text-info-subtle-ink"; marginIcon = "bi-lightning-charge"; }

    string DeltaClass(int delta) => delta > 0 ? "bg-brand-subtle text-brand"
        : delta < 0 ? "bg-danger-subtle text-danger"
        : "bg-neutral-subtle text-neutral";
    string DeltaText(int delta) => (delta > 0 ? "+" : "") + delta.ToString();
}

<div class="card match-card relative @Class @(Compact ? "" : "shadow-sm") @(meWon ? "border-brand" : meLost ? "border-danger" : "")">
    @if (Actions != null)
    {
        <div class="absolute top-0 right-0 mt-1 me-1" style="z-index: 2;">
            @Actions
        </div>
    }
    <div class="card-body @(Compact ? "p-2" : "match-card-body")">
        <div class="match-card-grid">
            <div class="flex-1 match-team">
                <div class="flex items-center justify-end gap-2 flex-wrap @(team1Won ? "font-bold text-brand" : "text-ink-muted")">
                    @foreach (var mp in team1Players.OrderBy(p => p.Position))
                    {
                        var isMe = mp.PlayerId == MyPlayerId;
                        <a href="/team/@TeamCode/players/@mp.PlayerId" class="no-underline text-right @(team1Won ? "text-brand" : "text-ink-muted") @(isMe ? "font-bold" : "")">
                            <Avatar AvatarId="@mp.PlayerAvatarId" Size="sm" />
                            <span class="ms-1 @(Compact ? "text-small" : "")">@mp.PlayerName</span>
                        </a>
                    }
                </div>
            </div>

            <div class="text-center px-4 match-card-score">
                <a href="/team/@TeamCode/matches/@Match.Id" class="no-underline block">
                    <div class="flex items-center justify-center gap-2">
                        <span class="badge @DeltaClass(team1Change)" title="Team 1 ELO change">
                            @DeltaText(team1Change)
                        </span>
                        @if (team1Won)
                        {
                            <i class="bi bi-trophy-fill text-warning" title="Team 1 won"></i>
                        }
                        <span class="text-h4 font-bold @(team1Won ? "text-brand" : "text-ink-muted")">@Match.Team1Score</span>
                        <span class="text-h4 text-ink-muted">:</span>
                        <span class="text-h4 font-bold @(!team1Won ? "text-brand" : "text-ink-muted")">@Match.Team2Score</span>
                        @if (!team1Won)
                        {
                            <i class="bi bi-trophy-fill text-warning" title="Team 2 won"></i>
                        }
                        <span class="badge @DeltaClass(team2Change)" title="Team 2 ELO change">
                            @DeltaText(team2Change)
                        </span>
                    </div>
                </a>
            </div>

            <div class="flex-1 match-team">
                <div class="flex items-center gap-2 flex-wrap @(!team1Won ? "font-bold text-brand" : "text-ink-muted")">
                    @foreach (var mp in team2Players.OrderBy(p => p.Position))
                    {
                        var isMe = mp.PlayerId == MyPlayerId;
                        <a href="/team/@TeamCode/players/@mp.PlayerId" class="no-underline @(!team1Won ? "text-brand" : "text-ink-muted") @(isMe ? "font-bold" : "")">
                            <Avatar AvatarId="@mp.PlayerAvatarId" Size="sm" />
                            <span class="ms-1 @(Compact ? "text-small" : "")">@mp.PlayerName</span>
                        </a>
                    }
                </div>
            </div>
        </div>

        @if (!Compact)
        {
            <div class="match-card-meta flex items-center justify-center gap-2 flex-wrap">
                @if (DateLabel != null)
                {
                    <small class="text-ink-muted" title="@DateTitle">
                        <i class="bi bi-clock me-1"></i>@DateLabel
                    </small>
                }
                else
                {
                    <small class="text-ink-muted">
                        <i class="bi bi-calendar3 me-1"></i>
                        <span class="match-date" data-utc="@Match.PlayedAt.ToString("o")">@Match.PlayedAt.ToString("g")</span>
                    </small>
                }
                @if (marginLabel != null)
                {
                    <span class="badge @marginCss" title="@($"Score margin: {margin}")">
                        <i class="bi @marginIcon me-1"></i>@marginLabel
                    </span>
                }
                @if (ShowSeasonChip)
                {
                    @if (SeasonName != null)
                    {
                        <span class="badge bg-brand-subtle text-brand-subtle-ink" title="Seasonal match">
                            <i class="bi bi-award me-1"></i>@SeasonName
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-neutral-subtle text-neutral" title="Not part of any season">off-season</span>
                    }
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public MatchDto Match { get; set; } = null!;
    [Parameter] public string? TeamCode { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>
    /// Extra classes for the card's root — in practice the outer margin. The card owns no
    /// spacing of its own: how far apart two cards sit is the containing feed's decision,
    /// and baking a margin in here meant every denser list had to override it with
    /// <c>!important</c> (utilities outrank the components layer).
    /// </summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Show the season / off-season chip (pages enable this once the team has seasons).</summary>
    [Parameter] public bool ShowSeasonChip { get; set; }
    /// <summary>Season name for the chip; null renders a muted "off-season" chip.</summary>
    [Parameter] public string? SeasonName { get; set; }

    /// <summary>
    /// Pre-formatted date/time shown on the meta line (non-compact only). When set, it is rendered
    /// as-is with a clock icon — callers pass a timezone-local label (e.g. "18:30") so no client-side
    /// JS date swap is needed. When null, falls back to the JS-localized <c>.match-date</c> span.
    /// </summary>
    [Parameter] public string? DateLabel { get; set; }

    /// <summary>Full local date/time for the <see cref="DateLabel"/> tooltip.</summary>
    [Parameter] public string? DateTitle { get; set; }

    [CascadingParameter(Name = "MyPlayerId")] public int? MyPlayerId { get; set; }
}
