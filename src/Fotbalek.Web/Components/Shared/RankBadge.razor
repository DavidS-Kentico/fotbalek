@* Leaderboard position chip — a filled metal for the podium, a plain numeral
   below it. Always one element of the same size, so a column of them never
   jumps between a medal and a number.

   Styled as .rank-pos in Styles/components/rankings.css. *@

<span class="rank-pos @VariantClass" title="@Title">@Rank</span>

@code {
    [Parameter, EditorRequired] public int Rank { get; set; }

    private string VariantClass => Rank switch
    {
        1 => "rank-pos--gold",
        2 => "rank-pos--silver",
        3 => "rank-pos--bronze",
        _ => string.Empty
    };

    /// <summary>The podium places say so on hover; the rest need no explaining.</summary>
    private string? Title => Rank switch
    {
        1 => "1st place",
        2 => "2nd place",
        3 => "3rd place",
        _ => null
    };
}
