@* Day-grouped list of match cards. Shared by Match History and the dashboard Recent
   Matches feed so the "Today / Yesterday / Mon, Jul 3" headers and card rendering stay
   identical. Pass an Actions template to render a per-match action area (e.g. the
   history row's dropdown); omit it for a plain feed (dashboard). *@
@inject TimeZoneService Tz

@foreach (var day in Matches.GroupBy(m => Tz.ToLocalDate(m.PlayedAt)))
{
    <div class="day-group @HeaderMarginClass">
        <span class="day-group__label">@DateFilterDisplay.FormatDayGroup(day.Key, Tz.Today)</span>
        <span class="day-group__count">@day.Count()</span>
    </div>

    @foreach (var match in day)
    {
        @if (Actions != null)
        {
            <MatchCard Match="@match" TeamCode="@TeamCode" Compact="@Compact" Class="@CardMarginClass"
                       ShowSeasonChip="@ShowSeasonChip" SeasonName="@match.SeasonName"
                       DateLabel="@Tz.ToLocalTime(match.PlayedAt).ToString("HH:mm")"
                       DateTitle="@Tz.FormatLocalDate(match.PlayedAt)">
                <Actions>@Actions(match)</Actions>
            </MatchCard>
        }
        else
        {
            <MatchCard Match="@match" TeamCode="@TeamCode" Compact="@Compact" Class="@CardMarginClass"
                       ShowSeasonChip="@ShowSeasonChip" SeasonName="@match.SeasonName"
                       DateLabel="@Tz.ToLocalTime(match.PlayedAt).ToString("HH:mm")"
                       DateTitle="@Tz.FormatLocalDate(match.PlayedAt)" />
        }
    }
}

@code {
    /// <summary>Matches to render, already ordered most-recent-first. Same-day rows group together.</summary>
    [Parameter, EditorRequired] public IEnumerable<MatchDto> Matches { get; set; } = [];

    [Parameter] public string? TeamCode { get; set; }

    /// <summary>Compact cards (dashboard) vs full cards (history).</summary>
    [Parameter] public bool Compact { get; set; }

    /// <summary>Show the season / off-season chip on each card.</summary>
    [Parameter] public bool ShowSeasonChip { get; set; }

    /// <summary>Optional per-match action area, rendered in each card's meta strip.</summary>
    [Parameter] public RenderFragment<MatchDto>? Actions { get; set; }

    /// <summary>Margin utilities for the day-group headers (history uses more top space than the dashboard).</summary>
    [Parameter] public string HeaderMarginClass { get; set; } = "mt-6 mb-2";

    /// <summary>Margin utilities between cards (the dashboard feed packs them tighter than history).</summary>
    [Parameter] public string CardMarginClass { get; set; } = "mb-3";
}
