<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <script>
        // Apply the saved colour theme before first paint so there's no flash of
        // the wrong theme on load. Mirrors window.fotbalekTheme in app.js, kept
        // inline + minimal because app.js only loads at the end of <body>.
        (function () {
            try {
                var m = document.cookie.match(/(?:^|;\s*)fotbalek-theme=(light|dark|system)/);
                var pref = m ? m[1] : 'system';
                var dark = pref === 'dark' ||
                    (pref !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
                document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
            } catch (e) { }
        })();
    </script>
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap-icons/bootstrap-icons.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Fotbalek.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    @* PWA: installable app shell. Icons/manifest are referenced at their literal (non-fingerprinted)
       paths on purpose so the service worker's precache list stays valid across builds. *@
    <link rel="manifest" href="manifest.webmanifest" />
    <meta name="theme-color" content="#198754" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Fotbálek" />
    <link rel="apple-touch-icon" href="icon-192.png" />
    @* Interactive, matching Routes: pages render their <PageTitle> only after the circuit
       starts (TeamLayout gates @Body past prerender), and a static HeadOutlet would never
       receive those updates — team pages ended up with no <title> at all. *@
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["js/ui.js"]"></script>
    <script src="@Assets["lib/chart.js/chart.umd.js"]"></script>
    <script src="@Assets["js/app.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
