@page "/team/{TeamCode}/matches"
@layout TeamLayout
@rendermode InteractiveServer
@attribute [Authorize]
@inject CurrentTeamProvider TeamAccess
@inject IScopedSender Sender
@inject ToastService Toasts
@inject NavigationManager Navigation
@inject TimeZoneService Tz
@using System.Globalization

<PageTitle>Match History - Foosball Manager</PageTitle>

@if (_loading)
{
    <LoadingSpinner />
}
else
{
    <PageContainer Focused>
        @* Season sits with the title because it re-scopes the whole page (and the
           server-side query behind it); the toolbar below holds the lenses that
           only narrow what has already been fetched.

           No "New match" button here: the team app bar carries one, it is sticky,
           and it keeps its "+" below lg where only the label is dropped — so a
           second one would repeat an affordance that is never off screen. The
           empty state's CTA is a different thing and stays. *@
        <PageHeader Title="Match History" Icon="bi bi-clock-history" Class="mb-3">
            <Actions>
                @if (_seasons.Count > 0)
                {
                    <SeasonSelector Seasons="_seasons" @bind-Value="_selectedSeasonId" OnChangedCallback="OnSeasonFilterChanged" />
                }
            </Actions>
        </PageHeader>

        @* One strip, split by question: row 1 is "when", row 2 is "who and how it
           went", and the player grid unfolds as a third only when asked for. A
           chip per player was a wall of twelve buttons above every visit. *@
        <div class="match-toolbar mb-4">
            <div class="match-toolbar__row">
                <TimePeriodFilter @bind-SelectedPeriod="_selectedPeriod"
                                  @bind-CustomStartDate="_customStartDate"
                                  @bind-CustomEndDate="_customEndDate"
                                  Today="Tz.Today"
                                  OnFilterChanged="OnFilterChanged" />
                <span class="match-toolbar__meta">@ScopeSummary</span>
            </div>

            <div class="match-toolbar__row">
                @if (MyPlayerId.HasValue)
                {
                    <button type="button"
                            class="btn btn-sm @(_myMatchesOnly ? "btn-brand" : "btn-outline-neutral")"
                            @onclick="ToggleMyMatches">
                        <i class="bi bi-person-check me-1"></i>My matches
                    </button>
                }

                @if (_canFilterByOutcome)
                {
                    <div class="btn-group btn-group-sm" role="group" aria-label="Outcome filter">
                        <button type="button"
                                class="btn @(_outcome == null ? "btn-neutral" : "btn-outline-neutral")"
                                @onclick='() => SetOutcome(null)'>All</button>
                        <button type="button"
                                class="btn @(_outcome == "wins" ? "btn-brand" : "btn-outline-brand")"
                                @onclick='() => SetOutcome("wins")'>
                            <i class="bi bi-trophy me-1"></i>Wins
                        </button>
                        <button type="button"
                                class="btn @(_outcome == "losses" ? "btn-danger" : "btn-outline-danger")"
                                @onclick='() => SetOutcome("losses")'>
                            <i class="bi bi-x-circle me-1"></i>Losses
                        </button>
                    </div>
                }

                @if (_players.Count > 0)
                {
                    <button type="button"
                            class="btn btn-sm @(_selectedPlayerIds.Count > 0 ? "btn-brand" : "btn-outline-neutral")"
                            @onclick="() => _playerPickerOpen = !_playerPickerOpen"
                            aria-expanded="@_playerPickerOpen">
                        <i class="bi bi-people me-1"></i>Players
                        <i class="bi bi-chevron-down ms-1 match-toolbar__caret @(_playerPickerOpen ? "match-toolbar__caret--open" : "")"></i>
                    </button>

                    @* The selection stays legible with the grid folded away. *@
                    @foreach (var player in _players.Where(p => _selectedPlayerIds.Contains(p.Id)))
                    {
                        <button type="button" class="btn btn-sm btn-outline-brand"
                                title="Remove @player.Name from the filter"
                                @onclick="() => TogglePlayer(player.Id)">
                            @player.Name<i class="bi bi-x-lg ms-1"></i>
                        </button>
                    }
                }

                @if (HasActiveFilters)
                {
                    <button type="button" class="btn btn-sm btn-link no-underline text-ink-muted match-toolbar__end"
                            @onclick="ClearAllFilters">
                        <i class="bi bi-x-circle me-1"></i>Clear all
                    </button>
                }
            </div>

            @if (_playerPickerOpen && _players.Count > 0)
            {
                <div class="match-toolbar__row match-toolbar__row--chips">
                    <span class="w-full text-ink-muted text-small">
                        Matches that included <strong>all</strong> of the chosen players — up to four.
                    </span>
                    @foreach (var player in _players)
                    {
                        var isSelected = _selectedPlayerIds.Contains(player.Id);
                        <button type="button"
                                class="btn btn-sm @(isSelected ? "btn-brand" : "btn-outline-neutral")"
                                @onclick="() => TogglePlayer(player.Id)"
                                disabled="@(!isSelected && _selectedPlayerIds.Count >= 4)">
                            @player.Name
                        </button>
                    }
                    @if (_selectedPlayerIds.Count > 0)
                    {
                        <button type="button" class="btn btn-sm btn-link no-underline text-ink-muted match-toolbar__end"
                                @onclick="ClearPlayerFilter">
                            <i class="bi bi-x-circle me-1"></i>Clear players
                        </button>
                    }
                </div>
            }
        </div>

        @if (_filteredMatches.Count > 0)
        {
            @if (_focusPlayerId.HasValue)
            {
                var focus = _focusPlayerId.Value;
                var rows = _filteredMatches
                    .Select(m => (Match: m, Mp: m.MatchPlayers.FirstOrDefault(mp => mp.PlayerId == focus)))
                    .Where(x => x.Mp != null)
                    .ToList();
                // Wins judged by score; the net-ELO tile sums the seasonal change when a season
                // filter is active, the all-time change otherwise (mixed views: every match has an
                // all-time change, only seasonal ones have a seasonal one).
                var wins = rows.Count(x => IsWinByScore(x.Match, x.Mp!));
                var losses = rows.Count - wins;
                var netElo = _selectedSeasonId != null
                    ? rows.Sum(x => x.Mp!.SeasonEloChange ?? 0)
                    : rows.Sum(x => x.Mp!.EloChange);
                var winRate = rows.Count > 0 ? (int)Math.Round(wins * 100.0 / rows.Count) : 0;
                var focusPlayer = _players.FirstOrDefault(p => p.Id == focus);

                @* Same dense KPI band the Statistics page leads with — these numbers
                   describe the filtered view, so they sit above the feed, not in it. *@
                <div class="flex items-center gap-2 mb-2">
                    <Avatar AvatarId="@(focusPlayer?.AvatarId ?? 1)" Size="sm" />
                    <span class="font-semibold">@(focusPlayer?.Name ?? "This player")</span>
                    <span class="text-ink-muted text-small">across @rows.Count @(rows.Count == 1 ? "match" : "matches") in view</span>
                </div>
                <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6">
                    <StatTile Dense Variant="brand" Icon="bi bi-trophy"
                              Value="@wins.ToString()" Label="Wins" />
                    <StatTile Dense Variant="danger" Icon="bi bi-x-circle"
                              Value="@losses.ToString()" Label="Losses" />
                    <StatTile Dense Variant="info" Icon="bi bi-percent"
                              Value="@($"{winRate}%")" Label="Win rate" />
                    <StatTile Dense Variant="@(netElo >= 0 ? "brand" : "danger")"
                              Icon="@(netElo >= 0 ? "bi bi-graph-up-arrow" : "bi bi-graph-down-arrow")"
                              Value="@($"{(netElo > 0 ? "+" : "")}{netElo}")" Label="Net ELO" />
                </div>
            }

            <MatchDayList Matches="GetVisibleMatches()" TeamCode="@TeamCode" ShowSeasonChip="@(_seasons.Count > 0)">
                <Actions Context="match">
                    <div class="dropdown">
                        <button class="btn btn-sm" type="button"
                                data-toggle="dropdown" aria-expanded="false" aria-label="Match actions">
                            <i class="bi bi-three-dots-vertical"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item" href="/team/@TeamCode/matches/@match.Id">
                                    <i class="bi bi-eye me-2"></i>View details
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="/team/@TeamCode/match/new?rematch=@match.Id">
                                    <i class="bi bi-arrow-repeat me-2"></i>Rematch
                                </a>
                            </li>
                            @if (_isCaptain)
                            {
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <button type="button" class="dropdown-item text-danger"
                                            @onclick="() => RequestDelete(match)">
                                        <i class="bi bi-trash me-2"></i>Delete
                                    </button>
                                </li>
                            }
                        </ul>
                    </div>
                </Actions>
            </MatchDayList>

            @if (_filteredMatches.Count > _visibleCount)
            {
                <LoadMoreButton Remaining="@(_filteredMatches.Count - _visibleCount)" OnClick="LoadMore" />
            }
        }
        else
        {
            <EmptyState Icon="bi bi-calendar-x" IconSize="xl" Padding="py-12"
                        Title="@(HasActiveFilters ? "No matches found for the selected filters" : "No matches recorded yet")"
                        Message="@(HasActiveFilters ? "Try adjusting your filters or selecting a different time period." : "Start playing and record your first match!")">
                @if (HasActiveFilters)
                {
                    <button class="btn btn-outline-brand" @onclick="ClearAllFilters">Clear Filters</button>
                }
                else
                {
                    <a href="/team/@TeamCode/match/new" class="btn btn-brand">Record First Match</a>
                }
            </EmptyState>
        }
    </PageContainer>

    <Modal Show="_pendingDelete != null" Title="Delete Match" OnClose="() => _pendingDelete = null">
        <Body>
            @if (_pendingDelete != null)
            {
                <p>Are you sure you want to delete this match? ELO changes will be reversed.</p>
                <div class="alert alert-neutral mb-0">
                    <strong>Score:</strong> @_pendingDelete.Team1Score : @_pendingDelete.Team2Score<br />
                    <strong>Date:</strong>
                    <span class="match-date" data-utc="@_pendingDelete.PlayedAt.ToString("o")">
                        @_pendingDelete.PlayedAt.ToString("g")
                    </span>
                </div>
            }
            <AlertMessage Message="@_deleteError" Variant="danger" Icon="bi bi-exclamation-triangle"
                          Dismissible="true" OnDismiss="() => _deleteError = null" />
        </Body>
        <Footer>
            <button type="button" class="btn btn-neutral" @onclick="() => _pendingDelete = null">Cancel</button>
            <SpinnerButton Variant="danger" Busy="_deleting" OnClick="ConfirmDelete">Delete Match</SpinnerButton>
        </Footer>
    </Modal>
}

@code {
    [Parameter] public string TeamCode { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "player")]  public int? PlayerParam { get; set; }
    [SupplyParameterFromQuery(Name = "period")]  public string? PeriodParam { get; set; }
    [SupplyParameterFromQuery(Name = "players")] public string? PlayersParam { get; set; }
    [SupplyParameterFromQuery(Name = "outcome")] public string? OutcomeParam { get; set; }
    [SupplyParameterFromQuery(Name = "mine")]    public bool? MineParam { get; set; }
    [SupplyParameterFromQuery(Name = "start")]   public string? StartParam { get; set; }
    [SupplyParameterFromQuery(Name = "end")]     public string? EndParam { get; set; }
    [SupplyParameterFromQuery(Name = "season")]  public string? SeasonParam { get; set; }

    [CascadingParameter(Name = "MyPlayerId")] public int? MyPlayerId { get; set; }

    private TeamDto? _team;
    private bool _loading = true;
    private bool _isCaptain;
    // Matches within the server-side scope (season + period filters run in the handler);
    // the player/mine/outcome filters below narrow this set in memory.
    private List<MatchDto> _scopedMatches = [];
    private List<MatchDto> _filteredMatches = [];
    private List<PlayerDto> _players = [];
    // Load-more window: how many of _filteredMatches are rendered; grows by DefaultPageSize
    // per "Load more" click and resets to one page whenever the filters change.
    private int _visibleCount = Constants.Pagination.DefaultPageSize;

    private string _selectedPeriod = "all";
    private HashSet<int> _selectedPlayerIds = [];
    private DateOnly? _customStartDate;
    private DateOnly? _customEndDate;
    private bool _myMatchesOnly;
    private string? _outcome;
    // The player grid is folded away by default — a chip per player is a wall of
    // buttons on a full roster, and most visits never touch it.
    private bool _playerPickerOpen;

    private List<SeasonDto> _seasons = [];
    private SeasonDto? _activeSeason;
    private int? _selectedSeasonId;
    private int? _defaultSeasonId;

    private MatchDto? _pendingDelete;
    private bool _deleting;
    private string? _deleteError;

    /// <summary>Trailing text of the toolbar's period row: how much of the filtered set is on screen.</summary>
    private string ScopeSummary
    {
        get
        {
            var total = _filteredMatches.Count;
            if (total == 0) return "No matches";
            var shown = Math.Min(_visibleCount, total);
            return shown < total
                ? $"Showing {shown} of {total} matches"
                : $"{total} {(total == 1 ? "match" : "matches")}";
        }
    }

    private bool HasActiveFilters =>
        _selectedPeriod != "all"
        || _selectedPlayerIds.Count > 0
        || _myMatchesOnly
        || _outcome != null
        || _selectedSeasonId != _defaultSeasonId;

    private bool _canFilterByOutcome =>
        (_myMatchesOnly && MyPlayerId.HasValue) || _selectedPlayerIds.Count == 1;

    // The player whose perspective we display in the summary bar:
    //  - "My matches" mode -> the logged-in user's player
    //  - single player selected -> that player
    private int? _focusPlayerId =>
        _myMatchesOnly && MyPlayerId.HasValue ? MyPlayerId :
        _selectedPlayerIds.Count == 1 ? _selectedPlayerIds.First() :
        (int?)null;

    private int? _lastMyPlayerId;
    private bool _dataLoaded;

    protected override void OnParametersSet()
    {
        // When the cascading MyPlayerId arrives (or changes) after the initial render,
        // re-apply the filter so "My matches" reflects the current player.
        if (_dataLoaded && _lastMyPlayerId != MyPlayerId)
        {
            _lastMyPlayerId = MyPlayerId;
            ApplyFilter();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Tz.EnsureResolvedAsync();
            _team = await TeamAccess.GetCurrentTeamAsync();
            _isCaptain = await TeamAccess.IsCaptainAsync();
            if (_team != null)
            {
                _players = (await Sender.Send(new GetTeamPlayersQuery(_team.Id))).Value;

                _seasons = (await Sender.Send(new GetSeasonsQuery(_team.Id))).Value;
                _activeSeason = _seasons.FirstOrDefault(s => s.IsActiveAt(DateTimeOffset.UtcNow));
                // "This season" is the default preset when an active season exists.
                _defaultSeasonId = _activeSeason?.Id;
                _selectedSeasonId = _defaultSeasonId;

                _customEndDate = Tz.Today;
                _customStartDate = _customEndDate.Value.AddMonths(-1);

                ApplyFiltersFromUrl();

                // Load after the URL filters are known — season + period filter server-side.
                await LoadMatchesAsync();

                _dataLoaded = true;
                _lastMyPlayerId = MyPlayerId;
                ApplyFilter();
            }
            _loading = false;
            StateHasChanged();
        }
    }

    private void ApplyFiltersFromUrl()
    {
        if (!string.IsNullOrWhiteSpace(PeriodParam))
        {
            _selectedPeriod = PeriodParam;
        }

        if (!string.IsNullOrWhiteSpace(StartParam) && DateOnly.TryParse(StartParam, CultureInfo.InvariantCulture, out var s))
            _customStartDate = s;
        if (!string.IsNullOrWhiteSpace(EndParam) && DateOnly.TryParse(EndParam, CultureInfo.InvariantCulture, out var e))
            _customEndDate = e;

        // Player IDs: support legacy ?player=X and new ?players=1,2,3
        if (PlayerParam.HasValue && _players.Any(p => p.Id == PlayerParam.Value))
        {
            _selectedPlayerIds.Add(PlayerParam.Value);
        }
        if (!string.IsNullOrWhiteSpace(PlayersParam))
        {
            foreach (var part in PlayersParam.Split(',', StringSplitOptions.RemoveEmptyEntries))
            {
                if (int.TryParse(part, out var id) && _players.Any(p => p.Id == id))
                    _selectedPlayerIds.Add(id);
                if (_selectedPlayerIds.Count >= 4) break;
            }
        }

        if (MineParam == true && MyPlayerId.HasValue) _myMatchesOnly = true;

        if (OutcomeParam is "wins" or "losses") _outcome = OutcomeParam;

        if (!string.IsNullOrWhiteSpace(SeasonParam))
        {
            if (SeasonParam == "all") _selectedSeasonId = null;
            else if (int.TryParse(SeasonParam, out var seasonId) && _seasons.Any(s => s.Id == seasonId))
                _selectedSeasonId = seasonId;
        }
    }

    /// <summary>Fetches the season/period scope — the handler filters server-side from the
    /// instant range (range math in Application/Common, instants computed here at the UI
    /// boundary per the timezone policy).</summary>
    private async Task LoadMatchesAsync()
    {
        if (_team == null) return;
        var (from, toExclusive) = PeriodInstantRange();
        _scopedMatches = (await Sender.Send(
            new GetMatchesQuery(_team.Id, 1, 10000, _selectedSeasonId, from, toExclusive))).Value;
    }

    /// <summary>The period selection as a [From, ToExclusive) instant range for server-side filtering.</summary>
    private (DateTimeOffset? From, DateTimeOffset? ToExclusive) PeriodInstantRange()
    {
        var range = DateFilterHelper.GetDateRange(_selectedPeriod, Tz.Today, _customStartDate, _customEndDate);
        if (range == null) return (null, null);
        var from = Tz.LocalDateTimeToInstant(range.Value.startDate.ToDateTime(TimeOnly.MinValue));
        var toExclusive = Tz.LocalDateTimeToInstant(range.Value.endDate.AddDays(1).ToDateTime(TimeOnly.MinValue));
        return (from, toExclusive);
    }

    private async Task OnFilterChanged()
    {
        await LoadMatchesAsync();
        ApplyFilter();
        SyncUrl();
    }

    /// <summary>SeasonSelector has already written <see cref="_selectedSeasonId"/>; re-fetch the scope.</summary>
    private async Task OnSeasonFilterChanged()
    {
        await LoadMatchesAsync();
        ApplyFilter();
        SyncUrl();
    }

    private void TogglePlayer(int playerId)
    {
        if (_selectedPlayerIds.Contains(playerId)) _selectedPlayerIds.Remove(playerId);
        else if (_selectedPlayerIds.Count < 4) _selectedPlayerIds.Add(playerId);
        if (!_canFilterByOutcome) _outcome = null;
        ApplyFilter();
        SyncUrl();
    }

    private void ClearPlayerFilter()
    {
        _selectedPlayerIds.Clear();
        if (!_canFilterByOutcome) _outcome = null;
        ApplyFilter();
        SyncUrl();
    }

    private void ToggleMyMatches()
    {
        _myMatchesOnly = !_myMatchesOnly;
        if (!_canFilterByOutcome) _outcome = null;
        ApplyFilter();
        SyncUrl();
    }

    private void SetOutcome(string? outcome)
    {
        _outcome = outcome;
        ApplyFilter();
        SyncUrl();
    }

    private async Task ClearAllFilters()
    {
        _selectedPeriod = "all";
        _selectedPlayerIds.Clear();
        _myMatchesOnly = false;
        _outcome = null;
        _selectedSeasonId = _defaultSeasonId;
        await LoadMatchesAsync();
        ApplyFilter();
        SyncUrl();
    }

    private void ApplyFilter()
    {
        // Season + period are already filtered server-side (LoadMatchesAsync); only the
        // player/mine/outcome lenses run here.
        var query = _scopedMatches.AsEnumerable();

        if (_selectedPlayerIds.Count > 0)
        {
            query = query.Where(m =>
                _selectedPlayerIds.All(pid => m.MatchPlayers.Any(mp => mp.PlayerId == pid)));
        }

        if (_myMatchesOnly && MyPlayerId.HasValue)
        {
            var mine = MyPlayerId.Value;
            query = query.Where(m => m.MatchPlayers.Any(mp => mp.PlayerId == mine));
        }

        if (_canFilterByOutcome && _outcome != null)
        {
            // Outcome is judged from the perspective of the focused player:
            // - "my matches" mode  -> MyPlayerId
            // - one player selected -> that player
            var focus = _myMatchesOnly ? MyPlayerId :
                        _selectedPlayerIds.Count == 1 ? _selectedPlayerIds.First() :
                        (int?)null;

            if (focus.HasValue)
            {
                var want = _outcome == "wins";
                query = query.Where(m =>
                {
                    var mp = m.MatchPlayers.FirstOrDefault(p => p.PlayerId == focus.Value);
                    return mp != null && IsWinByScore(m, mp) == want;
                });
            }
        }

        _filteredMatches = query.ToList();

        // Any filter change collapses the list back to a single page.
        _visibleCount = Constants.Pagination.DefaultPageSize;

        StateHasChanged();
    }

    private List<MatchDto> GetVisibleMatches() => _filteredMatches.Take(_visibleCount).ToList();

    private void LoadMore()
    {
        _visibleCount += Constants.Pagination.DefaultPageSize;
        StateHasChanged();
    }

    private static bool IsWinByScore(MatchDto match, MatchPlayerDto mp)
    {
        var teamScore = mp.TeamNumber == 1 ? match.Team1Score : match.Team2Score;
        var opponentScore = mp.TeamNumber == 1 ? match.Team2Score : match.Team1Score;
        return teamScore > opponentScore;
    }

    private void SyncUrl()
    {
        var qs = new Dictionary<string, object?>
        {
            ["season"]  = _selectedSeasonId == _defaultSeasonId
                            ? null
                            : _selectedSeasonId?.ToString() ?? "all",
            ["period"]  = _selectedPeriod == "all" ? null : _selectedPeriod,
            ["start"]   = _selectedPeriod == "custom" ? _customStartDate?.ToString("yyyy-MM-dd") : null,
            ["end"]     = _selectedPeriod == "custom" ? _customEndDate?.ToString("yyyy-MM-dd") : null,
            ["players"] = _selectedPlayerIds.Count > 0 ? string.Join(",", _selectedPlayerIds) : null,
            ["mine"]    = _myMatchesOnly ? "true" : null,
            ["outcome"] = _outcome,
            ["player"]  = null,   // clear legacy param
            ["page"]    = null,   // clear legacy param (pagination replaced by load-more)
            ["size"]    = null,   // clear legacy param
            ["message"] = null,   // one-shot
        };

        var newUri = Navigation.GetUriWithQueryParameters(qs);
        Navigation.NavigateTo(newUri, forceLoad: false, replace: true);
    }

    private void RequestDelete(MatchDto match)
    {
        _deleteError = null;
        _pendingDelete = match;
    }

    private async Task ConfirmDelete()
    {
        if (_pendingDelete == null || _team == null) return;

        _deleting = true;
        try
        {
            var result = await Sender.Send(new DeleteMatchCommand(_team.Id, _pendingDelete.Id));
            if (result.IsSuccess)
            {
                _scopedMatches.Remove(_pendingDelete);
                Toasts.Success("Match deleted.");
                _pendingDelete = null;
                ApplyFilter();
            }
            else
            {
                _deleteError = result.Error.Message;
            }
        }
        catch
        {
            _deleteError = "An error occurred while deleting the match.";
        }
        finally
        {
            _deleting = false;
        }
    }
}
