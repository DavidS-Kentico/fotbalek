@page "/account"
@attribute [Authorize]
@inject IScopedSender Sender
@inject TimeZoneService Tz
@inject ToastService Toasts
@inject IJSRuntime JS

<PageTitle>My account - Foosball Manager</PageTitle>

<PageContainer Focused Padding="py-6 lg:py-12">
    <PageHeader Title="My account" Icon="bi bi-person-circle">
        <Actions>
            <a href="/" class="btn btn-sm btn-outline-neutral">
                <i class="bi bi-house-door me-1"></i> Overview
            </a>
        </Actions>
    </PageHeader>

    @* The password form posts to /account/change-password and comes back as a redirect, so the
       outcome arrives in the querystring. Success is a toast (raised on first render); a failure
       stays inline in the form's own panel, because it is always something to correct and retry. *@

    @if (_loading)
    {
        <LoadingSpinner />
    }
    else if (_user != null)
    {
        <div class="panel">
            <div class="panel__head">
                <i class="bi bi-person"></i>
                <h2 class="panel__title">Profile</h2>
            </div>
            <div class="panel__body">
                <div class="flex justify-between flex-wrap gap-4">
                    <div>
                        <div class="text-ink-muted text-small">Username</div>
                        <div class="font-semibold">@_user.UserName</div>
                    </div>
                    <div>
                        <div class="text-ink-muted text-small">Member since</div>
                        <div class="font-semibold">@Tz.FormatLocalDate(_user.CreatedAt)</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="panel">
            <div class="panel__head">
                <i class="bi bi-palette"></i>
                <h2 class="panel__title">Appearance</h2>
            </div>
            <div class="panel__body">
                <div class="text-ink-muted text-small mb-4">Choose how Foosball Manager looks on this device.</div>
                <div class="btn-group" role="group" aria-label="Colour theme">
                    <button type="button" class="btn @ThemeButtonClass("light")" @onclick="@(() => SetTheme("light"))">
                        <i class="bi bi-sun-fill me-1"></i>Light
                    </button>
                    <button type="button" class="btn @ThemeButtonClass("dark")" @onclick="@(() => SetTheme("dark"))">
                        <i class="bi bi-moon-stars-fill me-1"></i>Dark
                    </button>
                    <button type="button" class="btn @ThemeButtonClass("system")" @onclick="@(() => SetTheme("system"))">
                        <i class="bi bi-circle-half me-1"></i>System
                    </button>
                </div>
            </div>
        </div>

        @* The page's ONE per-team list: each team's identity plus that team's own options. The bell's
           cog deep-links here via ?section=teams. *@
        <div class="panel" id="teams">
            <div class="panel__head">
                <i class="bi bi-people-fill"></i>
                <h2 class="panel__title">Teams</h2>
                @if (_memberships.Count > 0)
                {
                    <div class="panel__actions">
                        <a href="/create" class="btn btn-sm btn-outline-brand">
                            <i class="bi bi-plus-lg me-1"></i>Create
                        </a>
                        <a href="/join" class="btn btn-sm btn-outline-neutral">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Join
                        </a>
                    </div>
                }
            </div>
            @if (_memberships.Count == 0)
            {
                <div class="panel__body">
                    <EmptyState Icon="bi bi-shield" Message="You are not a member of any team yet." />
                    <div class="text-center">
                        <a href="/create" class="btn btn-brand btn-sm me-2">Create team</a>
                        <a href="/join" class="btn btn-outline-brand btn-sm">Join team</a>
                    </div>
                </div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var membership in _memberships)
                    {
                        <TeamCard @key="membership.Team.Id"
                                  Membership="membership"
                                  Preferences="PreferencesFor(membership.Team.Id)"
                                  JoinedText="@Tz.FormatLocalDate(membership.JoinedAt)"
                                  ExpandOptions="DeepLinkedToTeams"
                                  OnPreferencesChanged="ReloadPreferencesAsync" />
                    }
                </div>
            }
        </div>

        <div class="panel">
            <div class="panel__head">
                <i class="bi bi-key"></i>
                <h2 class="panel__title">Change password</h2>
            </div>
            <div class="panel__body">
                @* Every ?error= here is a rejected submission ("Incorrect password.", the policy
                   messages, the mismatch check) — the form is still on screen and the user has to
                   act on the reason, so it belongs beside it and not in a toast that times out. *@
                <AlertMessage Message="@Error" Variant="danger" Icon="bi bi-exclamation-triangle" />

                <form method="post" action="/account/change-password">
                    <AntiforgeryToken />

                    <div class="mb-4">
                        <label for="currentPassword" class="form-label">Current password</label>
                        <input id="currentPassword" name="currentPassword" type="password" class="form-control" autocomplete="current-password" required />
                    </div>

                    <div class="mb-4">
                        <label for="newPassword" class="form-label">New password</label>
                        <input id="newPassword" name="newPassword" type="password" class="form-control" autocomplete="new-password" required minlength="6" />
                        <div class="form-text">At least 6 characters.</div>
                    </div>

                    <div class="mb-4">
                        <label for="confirmPassword" class="form-label">Confirm new password</label>
                        <input id="confirmPassword" name="confirmPassword" type="password" class="form-control" autocomplete="new-password" required minlength="6" />
                    </div>

                    <button type="submit" class="btn btn-brand">
                        <i class="bi bi-check-lg me-1"></i>Change password
                    </button>
                </form>
            </div>
        </div>
    }
</PageContainer>

@code {
    private Fotbalek.Contracts.Account.AccountInfoDto? _user;
    private List<MembershipOverviewDto> _memberships = [];
    private bool _loading = true;
    private string _theme = "system";

    /// <summary>
    /// Resolved notification categories per team id. Keyed separately from <see cref="_memberships"/>
    /// because the two lists are deliberately different: memberships covers every team, preferences
    /// only the ones where the user has a claimed player. A team present in the first and absent from
    /// the second is exactly the "claim a player" case, which the card renders as such.
    /// </summary>
    private Dictionary<int, List<NotificationCategoryPreferenceDto>> _preferencesByTeam = [];

    private List<NotificationCategoryPreferenceDto>? PreferencesFor(int teamId) =>
        _preferencesByTeam.GetValueOrDefault(teamId);

    /// <summary>
    /// True when the bell's cog sent the visitor here. Only that link targets this section, and it
    /// exists precisely to reach the per-team switches — so the option groups start open rather than
    /// making someone who was deep-linked to a setting hunt for it behind a disclosure.
    /// </summary>
    private bool DeepLinkedToTeams =>
        string.Equals(Section, "teams", StringComparison.OrdinalIgnoreCase);

    private string ThemeButtonClass(string value) =>
        _theme == value ? "btn-brand" : "btn-outline-neutral";

    private async Task SetTheme(string value)
    {
        _theme = value;
        await JS.InvokeVoidAsync("fotbalekTheme.set", value);
    }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "success")]
    public string? Success { get; set; }

    /// <summary>Which section to scroll to — the bell panel's cog sends "teams". A plain URL fragment
    /// cannot do this: the panels only exist after the load below finishes, so the browser has nothing
    /// to scroll to when it handles the fragment (AI/notifications.md §8.5).</summary>
    [SupplyParameterFromQuery(Name = "section")]
    public string? Section { get; set; }

    private string SuccessMessage => Success switch
    {
        "password-changed" => "Your password has been changed.",
        _ => "Done."
    };

    /// <summary>
    /// Set once the data has loaded, consumed on the NEXT render pass. <c>StateHasChanged</c> only
    /// queues a render, so scrolling straight after it would look for a section that is not in the DOM
    /// yet — which is the same reason a plain URL fragment cannot work here (AI/notifications.md §8.5).
    /// </summary>
    private bool _scrollPending;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            if (_scrollPending)
            {
                _scrollPending = false;
                await ScrollToSectionAsync();
            }
            return;
        }

        // Outcome of the change-password POST, which redirects back here with a querystring.
        // Only the success half is a toast; ?error= renders inline next to the form.
        if (!string.IsNullOrEmpty(Success)) Toasts.Success(SuccessMessage);

        try
        {
            // Nothing under MainLayout resolves the browser timezone — do it here before
            // formatting any dates.
            await Tz.EnsureResolvedAsync();

            // Reflect the saved colour-theme preference in the selector.
            _theme = await JS.InvokeAsync<string>("fotbalekTheme.get");

            _user = (await Sender.Send(new GetMyAccountQuery())).Value;
            if (_user != null)
            {
                _memberships = (await Sender.Send(new GetMembershipOverviewQuery())).Value;
                await ReloadPreferencesAsync();
            }
        }
        finally
        {
            _loading = false;
            _scrollPending = !string.IsNullOrEmpty(Section);
            StateHasChanged();
        }
    }

    /// <summary>
    /// Re-reads the stored preferences after any card writes one. One query for every team, which is
    /// what the card's per-toggle save needs: on success it confirms the stored value, and on failure it
    /// is what puts the switch back to what the server actually holds.
    /// </summary>
    private async Task ReloadPreferencesAsync()
    {
        var result = await Sender.Send(new GetNotificationPreferencesQuery());
        if (result.IsSuccess)
            _preferencesByTeam = result.Value.ToDictionary(t => t.TeamId, t => t.Categories);
    }

    private async Task ScrollToSectionAsync()
    {
        if (string.IsNullOrEmpty(Section)) return;
        try
        {
            await JS.InvokeVoidAsync("fotbalekScrollToId", Section);
        }
        catch (Exception e) when (e is JSDisconnectedException or JSException)
        {
            // A scroll nicety is never worth failing a render over — the circuit may be tearing
            // down mid-call. (A missing section id is not an error at all: the helper itself
            // silently no-ops on an unknown element.)
        }
    }
}
