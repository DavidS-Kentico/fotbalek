@page "/team/{TeamCode}/seasons/{SeasonId:int}"
@layout TeamLayout
@rendermode InteractiveServer
@attribute [Authorize]
@inject CurrentTeamProvider TeamAccess
@inject IScopedSender Sender
@inject TimeZoneService Tz
@inject NavigationManager Navigation

<PageTitle>@(_season?.Name ?? "Season") - Foosball Manager</PageTitle>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_season == null)
{
    <PageContainer>
        <AlertMessage Message="Season not found." Variant="warning" Icon="bi bi-exclamation-triangle" />
        <a href="/team/@TeamCode/seasons" class="btn btn-primary">Back to Seasons</a>
    </PageContainer>
}
else
{
    var now = DateTimeOffset.UtcNow;
    var isScheduled = _season.IsScheduledAt(now);

    @* Focused (960px) to match the Rankings page — below the header this is the same
       standings / positions / pairs row lists, so it should not be a different width. *@
    <PageContainer Focused>
        <Breadcrumbs TeamCode="@TeamCode" Items="@(new Breadcrumbs.BreadcrumbItem[] {
            new("Seasons", $"/team/{TeamCode}/seasons"),
            new(_season.Name),
        })" />

        <Panel Class="@("mb-6" + (_season.IsActiveAt(now) ? " border-brand" : ""))">
                <div class="flex flex-wrap items-center gap-4">
                    <div class="grow min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                            <h2 class="mb-0">@_season.Name</h2>
                            @if (_season.IsActiveAt(now))
                            {
                                <span class="badge bg-brand">Live</span>
                            }
                            else if (isScheduled)
                            {
                                <span class="badge bg-info text-gray-900">Scheduled</span>
                            }
                            else if (_season.IsClosed)
                            {
                                <span class="badge bg-neutral">Closed</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-gray-900">Ended · closing…</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(_season.Description))
                        {
                            <div class="text-ink-muted mt-1">@_season.Description</div>
                        }
                        <div class="text-ink-muted text-small mt-1">
                            <i class="bi bi-calendar-range me-1"></i>@FormatPeriod()
                            <span class="mx-1">·</span>
                            <i class="bi bi-controller me-1"></i>@_matchCount match@(_matchCount == 1 ? "" : "es")
                            <span class="mx-1">·</span>
                            <i class="bi bi-people me-1"></i>@_standings.Count participant@(_standings.Count == 1 ? "" : "s")
                        </div>
                    </div>
                    @if (_isCaptain)
                    {
                        <SeasonManageActions Season="_season" OnChanged="ReloadAsync" OnDeleted="OnSeasonDeleted" />
                    }
                </div>
        </Panel>

        @if (isScheduled)
        {
            <EmptyState Icon="bi bi-hourglass-split" IconSize="xl" Padding="py-12"
                        Title="This season hasn't started yet"
                        Message="@($"It starts {Tz.ToLocalTime(_season.StartsAt):f}. Until then, matches are recorded off-season (or in the still-active previous season).")" />
        }
        else
        {
            @* ---------------- Awards ---------------- *@
            @if (_season.IsClosed && _awards.Count > 0)
            {
                <Panel Title="Awards" Icon="bi bi-trophy">
                        <div class="grid grid-cols-12 gap-4">
                            @AwardColumn(Constants.Seasons.AwardCategories.Player, "Top Players", "bi bi-star-fill")
                            @AwardColumn(Constants.Seasons.AwardCategories.Goalkeeper, "Top Goalkeepers", "bi bi-shield-fill")
                            @AwardColumn(Constants.Seasons.AwardCategories.Attacker, "Top Attackers", "bi bi-bullseye")
                            @AwardColumn(Constants.Seasons.AwardCategories.Pair, "Top Pairs", "bi bi-people-fill")
                        </div>
                </Panel>
            }
            else if (_season.IsClosed)
            {
                <div class="alert alert-light border py-2 text-small mb-6">
                    <i class="bi bi-info-circle me-1"></i>
                    This season closed with fewer than @Constants.Seasons.MinMatchesForAwards matches — standings were frozen, but no awards were generated.
                </div>
            }
            else
            {
                <Panel Title="Provisional awards" Icon="bi bi-trophy">
                    <Actions>
                        <span class="text-ink-muted text-small">preview — decided at season close</span>
                    </Actions>
                    <ChildContent>
                        @if (_matchCount < Constants.Seasons.MinMatchesForAwards)
                        {
                            <div class="text-ink-muted text-small">
                                <i class="bi bi-lock me-1"></i>Awards unlock at @Constants.Seasons.MinMatchesForAwards season matches
                                (currently @_matchCount). Below that, the season closes with frozen standings but no awards.
                            </div>
                        }
                        else
                        {
                            <div class="grid grid-cols-12 gap-4">
                                @PreviewColumn("Top Players", "bi bi-star-fill",
                                    _standings.Where(s => s.Matches >= Constants.Seasons.MinMatchesForPlayerAward).Take(3)
                                        .Select(s => (s.PlayerId, s.PlayerName, s.AvatarId, (string?)null)).ToList(),
                                    $"min {Constants.Seasons.MinMatchesForPlayerAward} matches")
                                @PreviewColumn("Top Goalkeepers", "bi bi-shield-fill",
                                    _goalkeepers.Take(3).Select(p => (p.PlayerId, p.PlayerName, p.AvatarId, (string?)$"{p.AverageGoals:F1} conceded/game")).ToList(),
                                    $"min {Constants.TimeThresholds.MinGamesForPositionBadge} matches as GK")
                                @PreviewColumn("Top Attackers", "bi bi-bullseye",
                                    _attackers.Take(3).Select(p => (p.PlayerId, p.PlayerName, p.AvatarId, (string?)$"{p.AverageGoals:F1} scored/game")).ToList(),
                                    $"min {Constants.TimeThresholds.MinGamesForPositionBadge} matches as ATK")
                                @PreviewPairColumn()
                            </div>
                        }
                    </ChildContent>
                </Panel>
            }

            @* ---------------- Standings ---------------- *@
            <Panel Flush Class="mb-6">
                <Header>
                    <i class="bi bi-bar-chart"></i>
                    <h2 class="panel__title">
                        @(_season.IsClosed ? "Final standings" : "Standings")
                        <small class="text-ink-muted font-normal">(seasonal ELO@(_season.IsClosed ? ", frozen at close" : ""))</small>
                    </h2>
                </Header>
                <ChildContent>
                    <StandingsList Rows="_standingsRows"
                                   TeamCode="@TeamCode"
                                   MyPlayerId="MyPlayerId"
                                   EmptyMessage="No seasonal matches yet." />
                </ChildContent>
            </Panel>

            @* ---------------- Position tables ---------------- *@
            <div class="grid grid-cols-12 gap-4 mb-6">
                <div class="col-span-12 lg:col-span-6">
                    <PositionRankingList Players="_goalkeepers"
                                         Title="Best Goalkeepers"
                                         Icon="bi bi-shield-fill"
                                         HeaderHint="@($"(min {Constants.TimeThresholds.MinGamesForPositionBadge} games as GK)")"
                                         TeamCode="@TeamCode"
                                         MyPlayerId="MyPlayerId"
                                         AverageColumnLabel="Conceded"
                                         AverageColumnTooltip="Average goals conceded per game"
                                         AverageColumnClass="text-neutral"
                                         EmptyIcon="bi bi-shield"
                                         EmptyMessage="@($"No goalkeepers with at least {Constants.TimeThresholds.MinGamesForPositionBadge} games.")" />
                </div>
                <div class="col-span-12 lg:col-span-6">
                    <PositionRankingList Players="_attackers"
                                         Title="Best Attackers"
                                         Icon="bi bi-bullseye"
                                         HeaderHint="@($"(min {Constants.TimeThresholds.MinGamesForPositionBadge} games as ATK)")"
                                         TeamCode="@TeamCode"
                                         MyPlayerId="MyPlayerId"
                                         AverageColumnLabel="Scored"
                                         AverageColumnTooltip="Average goals scored per game"
                                         AverageColumnClass="text-danger"
                                         EmptyIcon="bi bi-bullseye"
                                         EmptyMessage="@($"No attackers with at least {Constants.TimeThresholds.MinGamesForPositionBadge} games.")" />
                </div>
            </div>

            @* ---------------- Pairs ---------------- *@
            <PairRankingList Pairs="_pairs"
                             Title="Best Pairs"
                             Icon="bi bi-people"
                             HeaderHint="@($"(min {Constants.TimeThresholds.MinGamesForPartnerStats} matches together)")"
                             TeamCode="@TeamCode"
                             MyPlayerId="MyPlayerId"
                             ShowAverageScore="@(!_season.IsClosed)"
                             Class="mb-6"
                             EmptyMessage="@($"No pairs with at least {Constants.TimeThresholds.MinGamesForPartnerStats} matches together.")" />

            <a href="/team/@TeamCode/matches?season=@_season.Id" class="btn btn-outline-neutral btn-sm">
                <i class="bi bi-list-ul me-1"></i> View the season's matches
            </a>
        }
    </PageContainer>
}

@code {
    [Parameter] public string TeamCode { get; set; } = string.Empty;
    [Parameter] public int SeasonId { get; set; }
    [CascadingParameter(Name = "MyPlayerId")] public int? MyPlayerId { get; set; }

    private TeamDto? _team;
    private SeasonDto? _season;
    private bool _loading = true;
    private bool _isCaptain;
    private int _matchCount;
    private List<SeasonStandingRow> _standings = [];
    /// <summary>The same standings as the shared leaderboard row. Mapped once on load rather
    /// than in the markup, which would remap the whole table on every render.</summary>
    private List<StandingsList.Row> _standingsRows = [];
    private List<PositionRanking> _goalkeepers = [];
    private List<PositionRanking> _attackers = [];
    private List<PairStats> _pairs = [];
    private List<SeasonAwardDto> _awards = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await Tz.EnsureResolvedAsync();
        _team = await TeamAccess.GetCurrentTeamAsync();
        if (_team != null)
        {
            _isCaptain = await TeamAccess.IsCaptainAsync(_team);
            await LoadAsync();
        }
        _loading = false;
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        if (_team == null) return;

        // A failure here is "no such season for you": the membership probe deliberately answers
        // NotMember for a nonexistent id (no id-probing), and the season can vanish mid-circuit —
        // deleted from this very page, or a mistyped URL. Either way this page shows not-found.
        var seasonResult = await Sender.Send(new GetSeasonQuery(SeasonId));
        if (seasonResult.IsFailure || seasonResult.Value is not { } season || season.TeamId != _team.Id)
        {
            _season = null;
            return;
        }
        _season = season;
        _matchCount = (await Sender.Send(new GetSeasonMatchCountQuery(season.Id))).Value;
        _standings = (await Sender.Send(new GetSeasonStandingsQuery(season.Id))).Value;
        _standingsRows = _standings.Select(r => StandingsList.From(r)).ToList();
        var positions = (await Sender.Send(new GetSeasonPositionRankingsQuery(season.Id))).Value;
        (_goalkeepers, _attackers) = (positions.Goalkeepers, positions.Attackers);
        _pairs = (await Sender.Send(new GetSeasonPairRankingsQuery(season.Id))).Value;
        _awards = season.IsClosed ? (await Sender.Send(new GetSeasonAwardsQuery(season.Id))).Value : [];
    }

    private async Task ReloadAsync()
    {
        await LoadAsync();
        StateHasChanged();
    }

    private void OnSeasonDeleted()
    {
        Navigation.NavigateTo($"/team/{TeamCode}/seasons");
    }

    private string FormatPeriod()
    {
        if (_season == null) return string.Empty;
        var start = Tz.FormatLocalDate(_season.StartsAt);
        var end = _season.EndsAt is { } ends ? Tz.FormatLocalDate(ends) : "open-ended";
        return $"{start} – {end}";
    }

    private static string Medal(int rank) => rank switch { 1 => "🥇", 2 => "🥈", _ => "🥉" };

    private RenderFragment AwardColumn(string category, string title, string icon) => __builder =>
    {
        // Pair awards have one row per member — show each pair once, from the smaller-id member's row.
        var rows = _awards
            .Where(a => a.Category == category &&
                        (a.PartnerPlayerId == null || a.PlayerId < a.PartnerPlayerId))
            .OrderBy(a => a.Rank)
            .ToList();

        <div class="col-span-12 md:col-span-6 xl:col-span-3">
            <div class="font-semibold text-small mb-2"><i class="@icon me-1"></i>@title</div>
            @if (rows.Count == 0)
            {
                <div class="text-ink-muted text-small italic">Not awarded — no eligible candidates.</div>
            }
            else
            {
                @foreach (var award in rows)
                {
                    <div class="flex items-center gap-2 mb-1">
                        <span title="@($"Rank {award.Rank}")">@Medal(award.Rank)</span>
                        <a href="/team/@TeamCode/players/@award.PlayerId" class="no-underline inline-flex items-center gap-1">
                            <Avatar AvatarId="@award.PlayerAvatarId" Size="sm" />
                            <span class="text-small">@award.PlayerName</span>
                        </a>
                        @if (award.PartnerPlayerId != null)
                        {
                            <span class="text-ink-muted text-small">&</span>
                            <a href="/team/@TeamCode/players/@award.PartnerPlayerId" class="no-underline inline-flex items-center gap-1">
                                <Avatar AvatarId="@(award.PartnerPlayerAvatarId ?? 1)" Size="sm" />
                                <span class="text-small">@award.PartnerPlayerName</span>
                            </a>
                        }
                    </div>
                }
            }
        </div>
    };

    private RenderFragment PreviewColumn(string title, string icon, List<(int PlayerId, string Name, int AvatarId, string? Detail)> rows, string hint) => __builder =>
    {
        <div class="col-span-12 md:col-span-6 xl:col-span-3">
            <div class="font-semibold text-small mb-2"><i class="@icon me-1"></i>@title <span class="text-ink-muted font-normal">(@hint)</span></div>
            @if (rows.Count == 0)
            {
                <div class="text-ink-muted text-small italic">No eligible candidates yet.</div>
            }
            else
            {
                @for (var i = 0; i < rows.Count; i++)
                {
                    var row = rows[i];
                    <div class="flex items-center gap-2 mb-1">
                        <span>@Medal(i + 1)</span>
                        <a href="/team/@TeamCode/players/@row.PlayerId" class="no-underline inline-flex items-center gap-1">
                            <Avatar AvatarId="@row.AvatarId" Size="sm" />
                            <span class="text-small">@row.Name</span>
                        </a>
                        @if (row.Detail != null)
                        {
                            <span class="text-ink-muted text-small">@row.Detail</span>
                        }
                    </div>
                }
            }
        </div>
    };

    private RenderFragment PreviewPairColumn() => __builder =>
    {
        var topPairs = _pairs.Take(3).ToList();
        <div class="col-span-12 md:col-span-6 xl:col-span-3">
            <div class="font-semibold text-small mb-2"><i class="bi bi-people-fill me-1"></i>Top Pairs <span class="text-ink-muted font-normal">(min @Constants.TimeThresholds.MinGamesForPartnerStats together)</span></div>
            @if (topPairs.Count == 0)
            {
                <div class="text-ink-muted text-small italic">No eligible candidates yet.</div>
            }
            else
            {
                @for (var i = 0; i < topPairs.Count; i++)
                {
                    var pair = topPairs[i];
                    <div class="flex items-center gap-2 mb-1">
                        <span>@Medal(i + 1)</span>
                        <span class="text-small">@pair.Player1Name & @pair.Player2Name</span>
                        <span class="text-ink-muted text-small">@pair.WinRate.ToString("F0")%</span>
                    </div>
                }
            }
        </div>
    };
}
