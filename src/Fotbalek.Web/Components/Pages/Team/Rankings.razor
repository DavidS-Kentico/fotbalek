@page "/team/{TeamCode}/rankings"
@layout TeamLayout
@rendermode InteractiveServer
@attribute [Authorize]
@inject CurrentTeamProvider TeamAccess
@inject IScopedSender Sender
@inject NavigationManager Nav

<PageTitle>Rankings - Foosball Manager</PageTitle>

@if (_loading)
{
    <LoadingSpinner />
}
else
{
    @* One scope (the selected season, or all-time) shown through three panes.
       The standings are the page, so they lead; the position and pair ladders are
       a click away rather than three more screens of scrolling past them.

       Focused (960px), like Match History: every pane is a single column of rows,
       and the wide tier stretched them to 1320px of mostly empty middle. *@
    <PageContainer Focused>
        <PageHeader Title="Rankings" Icon="bi bi-bar-chart" Class="mb-3">
            <Actions>
                @if (_seasons.Count > 0)
                {
                    <SeasonSelector Seasons="_seasons" @bind-Value="_selectedSeasonId" OnChangedCallback="OnScopeChanged" />
                }
            </Actions>
        </PageHeader>

        @* Which ladder every pane below is showing. A hairline strip, not a panel —
           the same chrome-not-content rule as the Statistics scope bar. *@
        <div class="scope-bar mb-4">
            <span class="font-semibold">
                <i class="bi bi-graph-up-arrow text-brand me-1"></i>@LadderLabel
            </span>
            @if (_selectedSeason?.IsClosed == true)
            {
                <span class="badge bg-neutral-subtle text-neutral-subtle-ink border border-neutral-subtle-edge">
                    final standings
                </span>
            }
            <span class="scope-bar__meta">@ScopeSummary</span>
        </div>

        <TabStrip Tabs="@BuildTabs()" ActiveId="@_tab" OnSelect="SwitchTab" />

        @* ---------------- PLAYERS ---------------- *@
        @if (_tab == TabPlayers)
        {
            @* Headless: the tab above already names the pane, so a titled head here
               would only repeat it. *@
            <Panel Flush>
                <StandingsList Rows="_standings"
                               TeamCode="@TeamCode"
                               MyPlayerId="MyPlayerId"
                               CaptainPlayerId="_captainPlayerId"
                               Stats="_stats"
                               EmptyMessage="@(_selectedSeason != null ? "No seasonal matches yet." : "No players yet.")" />
            </Panel>
        }
        @* ---------------- POSITIONS ---------------- *@
        else if (_tab == TabPositions)
        {
            <div class="grid grid-cols-12 gap-4">
                <div class="col-span-12 lg:col-span-6">
                    <PositionRankingList Players="_goalkeepers"
                                         Title="Best Goalkeepers"
                                         Icon="bi bi-shield-fill"
                                         HeaderHint="@($"(min {Constants.TimeThresholds.MinGamesForPositionBadge} games as GK)")"
                                         TeamCode="@TeamCode"
                                         MyPlayerId="MyPlayerId"
                                         CaptainPlayerId="_captainPlayerId"
                                         AverageColumnLabel="Conceded"
                                         AverageColumnTooltip="Average goals conceded per game"
                                         AverageColumnClass="text-neutral"
                                         EmptyIcon="bi bi-shield"
                                         EmptyMessage="@($"No goalkeepers with at least {Constants.TimeThresholds.MinGamesForPositionBadge} games yet.")" />
                </div>
                <div class="col-span-12 lg:col-span-6">
                    <PositionRankingList Players="_attackers"
                                         Title="Best Attackers"
                                         Icon="bi bi-bullseye"
                                         HeaderHint="@($"(min {Constants.TimeThresholds.MinGamesForPositionBadge} games as ATK)")"
                                         TeamCode="@TeamCode"
                                         MyPlayerId="MyPlayerId"
                                         CaptainPlayerId="_captainPlayerId"
                                         AverageColumnLabel="Scored"
                                         AverageColumnTooltip="Average goals scored per game"
                                         AverageColumnClass="text-danger"
                                         EmptyIcon="bi bi-bullseye"
                                         EmptyMessage="@($"No attackers with at least {Constants.TimeThresholds.MinGamesForPositionBadge} games yet.")" />
                </div>
            </div>
        }
        @* ---------------- PAIRS ---------------- *@
        else if (_tab == TabPairs)
        {
            <PairRankingList Pairs="_pairRankings"
                             Title="Best Pairs"
                             Icon="bi bi-people"
                             HeaderHint="@($"(min {Constants.TimeThresholds.MinGamesForPartnerStats} matches together)")"
                             TeamCode="@TeamCode"
                             MyPlayerId="MyPlayerId"
                             CaptainPlayerId="_captainPlayerId"
                             ShowAverageScore="@(_selectedSeason?.IsClosed != true)"
                             EmptyMessage="@($"Not enough matches to rank pairs yet (minimum {Constants.TimeThresholds.MinGamesForPartnerStats} matches per pair).")" />
        }
    </PageContainer>
}

@code {
    [Parameter] public string TeamCode { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "tab")] public string? TabParam { get; set; }

    private TeamDto? _team;
    private bool _loading = true;
    private List<SeasonDto> _seasons = [];
    private int? _selectedSeasonId;
    private SeasonDto? _selectedSeason;

    /// <summary>Standings for the selected scope — the seasonal ladder or the all-time one,
    /// both mapped to the shared row so the pane does not care which it got.</summary>
    private List<StandingsList.Row> _standings = [];
    private List<PairStats> _pairRankings = [];
    private List<PositionRanking> _goalkeepers = [];
    private List<PositionRanking> _attackers = [];
    private List<StatResult> _stats = [];
    // Player claimed by the team captain, if any — marked with the armband "C".
    private int? _captainPlayerId;
    [CascadingParameter(Name = "MyPlayerId")] public int? MyPlayerId { get; set; }

    // ---- Panes ----
    // Ids double as the ?tab= value, so a pane is linkable and survives a refresh
    // (same contract as Statistics and Player detail).
    private const string TabPlayers = "players";
    private const string TabPositions = "positions";
    private const string TabPairs = "pairs";

    private static readonly string[] TabIds = [TabPlayers, TabPositions, TabPairs];

    private string _tab = TabPlayers;

    protected override void OnParametersSet()
    {
        var requested = (TabParam ?? TabPlayers).ToLowerInvariant();
        if (!TabIds.Contains(requested)) requested = TabPlayers;
        _tab = requested;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _team = await TeamAccess.GetCurrentTeamAsync();
            if (_team != null)
            {
                if (_team.CaptainUserId is int captainUserId)
                {
                    _captainPlayerId = (await Sender.Send(new GetUserPlayerInTeamQuery(_team.Id, captainUserId))).Value?.Id;
                }

                _seasons = (await Sender.Send(new GetSeasonsQuery(_team.Id))).Value;
                // Default scope = the current season; all-time when none is active (idle default).
                _selectedSeasonId = _seasons.FirstOrDefault(s => s.IsActiveAt(DateTimeOffset.UtcNow))?.Id;
                await LoadScopeAsync();
            }
            _loading = false;
            StateHasChanged();
        }
    }

    private void SwitchTab(string tab)
    {
        if (_tab == tab) return;
        // Players is the default, so it stays out of the URL.
        var target = string.Equals(tab, TabPlayers, StringComparison.OrdinalIgnoreCase) ? null : tab;
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("tab", target), replace: true);
    }

    private List<TabStrip.TabItem> BuildTabs() =>
    [
        new(TabPlayers, "bi bi-person", "Players", _standings.Count),
        new(TabPositions, "bi bi-shield-fill", "Positions", _goalkeepers.Count + _attackers.Count),
        new(TabPairs, "bi bi-people", "Pairs", _pairRankings.Count),
    ];

    /// <summary>Which ladder the panes are showing — the two are ranked separately.</summary>
    private string LadderLabel => _selectedSeason is { } season
        ? $"Seasonal ELO · {season.Name}"
        : "All-time ELO";

    /// <summary>
    /// How many of the ranked players have actually played in this scope. Everyone on
    /// the ladder has a rating, so a player with no matches still holds a position —
    /// this is what explains the "—" in their record.
    /// </summary>
    private string ScopeSummary
    {
        get
        {
            var total = _standings.Count;
            var played = _standings.Count(r => r.Matches > 0);
            var players = $"{total} {(total == 1 ? "player" : "players")}";
            return played == total ? players : $"{players} · {played} with matches";
        }
    }

    private async Task OnScopeChanged()
    {
        await LoadScopeAsync();
        StateHasChanged();
    }

    private async Task LoadScopeAsync()
    {
        if (_team == null) return;

        _selectedSeason = _selectedSeasonId is int id ? _seasons.FirstOrDefault(s => s.Id == id) : null;

        if (_selectedSeason != null)
        {
            // Season scope: live aggregation for the active season, frozen tables for closed ones.
            _standings = (await Sender.Send(new GetSeasonStandingsQuery(_selectedSeason.Id))).Value
                .Select(r => StandingsList.From(r)).ToList();
            var positions = (await Sender.Send(new GetSeasonPositionRankingsQuery(_selectedSeason.Id))).Value;
            (_goalkeepers, _attackers) = (positions.Goalkeepers, positions.Attackers);
            _pairRankings = (await Sender.Send(new GetSeasonPairRankingsQuery(_selectedSeason.Id))).Value;

            // Badge chips come from the season-scoped StatContext — computed on the fly even for
            // closed seasons (their matches are immutable, so this is safe).
            _stats = (await Sender.Send(new GetTeamStatsQuery(_team.Id, _selectedSeason.Id))).Value;
        }
        else
        {
            _standings = (await Sender.Send(new GetRankingsQuery(_team.Id))).Value
                .Select(r => StandingsList.From(r)).ToList();
            _pairRankings = (await Sender.Send(new GetPairRankingsQuery(_team.Id))).Value;
            var positions = (await Sender.Send(new GetPositionRankingsQuery(_team.Id))).Value;
            (_goalkeepers, _attackers) = (positions.Goalkeepers, positions.Attackers);
            _stats = (await Sender.Send(new GetTeamStatsQuery(_team.Id))).Value;
        }
    }
}
